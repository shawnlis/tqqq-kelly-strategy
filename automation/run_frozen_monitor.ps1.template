$ErrorActionPreference = "Stop"

$RepoRoot = "C:\Strategies\TQQQ Kelly"
Set-Location -LiteralPath $RepoRoot

$LogDir = Join-Path $RepoRoot "logs"
New-Item -ItemType Directory -Force -Path $LogDir | Out-Null

$RunDate = Get-Date -Format "yyyyMMdd"
$LogPath = Join-Path $LogDir "frozen_monitor_$RunDate.log"

$Args = @(
    "minimal_tqqq_risk_baseline.py",
    "--start", "2015-01-01",
    "--end", "auto",
    "--frozen_monitor",
    "--monitor_out", "reports/minimal_baseline/frozen_monitor_latest.md",
    "--append_monitor_history",
    "--monitor_history_csv", "reports/minimal_baseline/frozen_monitor_history.csv"
)

"[$(Get-Date -Format o)] Starting frozen MA150 monitor." | Out-File -FilePath $LogPath -Encoding utf8 -Append
& python @Args *>&1 | Tee-Object -FilePath $LogPath -Append
$ExitCode = $LASTEXITCODE

if ($ExitCode -ne 0) {
    "[$(Get-Date -Format o)] Frozen MA150 monitor failed with exit code $ExitCode." | Out-File -FilePath $LogPath -Encoding utf8 -Append
    exit $ExitCode
}

"[$(Get-Date -Format o)] Frozen MA150 monitor completed successfully." | Out-File -FilePath $LogPath -Encoding utf8 -Append
exit 0
